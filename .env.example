# n8n — forwards consultation/workshop form submissions to the automation
# workflow (Google Sheets append + AI lead scoring). Leave unset to skip
# forwarding (submissions are still logged server-side).
N8N_WEBHOOK_URL=
# Shared secret sent as the x-webhook-secret header on every forwarded
# request. Set the same value on the n8n Webhook node's Header Auth
# credential so the workflow only accepts requests from this server.
N8N_WEBHOOK_SECRET=
